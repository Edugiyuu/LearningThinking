{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "spike-camada",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "spikes/camada-react-flow",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev",
        "--",
        "--port",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "3200",
        "-d",
        "web/out"
      ],
      "port": 3200
    }
  ]
}
